<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>biobuzz FTC Auto Simulator</title>
<style>
:root{--bg:#15130e;--surf:#201d15;--text:#f1eee3;--mute:#a59f8d;--line:#383323;--acc:#f2b632;--field:#2a261b;--grid:#413b29;--robot:#60a5fa;--bad:#f87171;color-scheme:dark;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root[data-theme="light"]{--bg:#ffffff;--surf:#ffffff;--text:#1d1b16;--mute:#6b665a;--line:#e3e0d6;--acc:#e8a317;--field:#e9e6dc;--grid:#cfcabb;--robot:#2563eb;--bad:#dc2626;color-scheme:light}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif}
header{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line)}
header h1{font-size:18px;margin:0}header span{color:var(--mute);font-size:13px}
main{display:grid;grid-template-columns:minmax(0,1fr) 400px;gap:16px;padding:16px;max-width:1240px;margin:auto}
@media(max-width:880px){main{grid-template-columns:minmax(0,1fr)}}
.card{background:var(--surf);border:1px solid var(--line);border-radius:12px;padding:12px;min-width:0}
canvas{width:100%;aspect-ratio:1;display:block;border-radius:8px;cursor:crosshair;touch-action:manipulation}
.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:10px}
button,select,input,textarea{font:inherit;color:var(--text)}
button{background:var(--surf);border:1px solid var(--line);border-radius:8px;padding:6px 12px;cursor:pointer}
button.p{background:var(--acc);border-color:var(--acc);color:#1d1b16;font-weight:600}
input[type=number],select{background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:4px 6px;width:68px}
select{width:auto}input[type=range]{flex:1;min-width:120px;accent-color:var(--acc)}
.time{font-variant-numeric:tabular-nums;font-weight:600}.time.over{color:var(--bad)}
h2{font-size:13px;margin:0 0 8px;text-transform:uppercase;letter-spacing:.05em;color:var(--mute)}
.row{display:flex;align-items:center;gap:6px;padding:5px 6px;border-radius:8px;margin-bottom:4px;border:1px solid transparent;flex-wrap:wrap}
.row.act{border-color:var(--acc);background:color-mix(in srgb,var(--acc) 14%,transparent)}
.row b{font-size:13px;min-width:78px}.row label{font-size:12px;color:var(--mute)}.row input{width:58px}
.row small{color:var(--mute);font-size:11px;font-variant-numeric:tabular-nums}.x{margin-left:auto;padding:2px 8px}
#list{max-height:320px;overflow-y:auto;margin-bottom:8px}
.set{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;font-size:13px}.set label{display:flex;justify-content:space-between;align-items:center;gap:6px}
.hint{color:var(--mute);font-size:12px;margin:8px 0 0}
#status{font-size:13px;margin-top:8px;min-height:1.4em}#status .bad{color:var(--bad);font-weight:600}
textarea{width:100%;height:110px;background:var(--bg);border:1px solid var(--line);border-radius:8px;font:12px monospace;padding:6px;margin-top:8px}
.stack{display:flex;flex-direction:column;gap:16px}
button.sm{font-size:12px;padding:3px 9px;border-radius:7px}.hint:empty{display:none}
.tools{gap:6px 8px}.tools label{font-size:12px;display:flex;align-items:center;gap:4px}.tools input[type=number]{width:50px;padding:2px 5px;font-size:12px}.tools select{padding:2px 4px;font-size:12px}.tools input[type=checkbox]{width:auto}
summary{cursor:pointer;list-style-position:inside}summary h2{vertical-align:middle}
.mrow input[type=text]{width:118px;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:4px 6px}.mrow input[type=number]{width:52px}.mrow input[type=checkbox]{width:auto}.mrow b{min-width:92px}
#aiq{height:76px;margin-top:0}.chips button{font-size:12px;padding:3px 9px;color:var(--mute)}#aimsg{min-height:1.4em;white-space:pre-wrap}
label.chk{font-size:13px;display:flex;gap:6px;align-items:center}
</style>
</head>
<body>
<header><svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true"><ellipse cx="13" cy="15" rx="8" ry="6" fill="#e8a317"/><path d="M9 11v8M13 10v10M17 11v8" stroke="#1d1b16" stroke-width="2"/><ellipse cx="9" cy="8" rx="4" ry="3" fill="#93c5fd" opacity=".8"/><ellipse cx="17" cy="8" rx="4" ry="3" fill="#93c5fd" opacity=".8"/></svg>
<h1>biobuzz Auto Simulator</h1><span>FTC · 144″ field · 30 s autonomous</span>
<div class="bar" style="margin:0 0 0 auto;gap:0"><b style="font-size:13px;margin-right:8px">Drive</b><button id="dm-tank" class="p" style="border-radius:8px 0 0 8px">Tank</button><button id="dm-strafe" style="border-radius:0 8px 8px 0">Strafer</button></div></header>
<main>
<section class="card">
<canvas id="cv" width="720" height="720"></canvas>
<div class="bar">
<button class="p" id="play">▶ Play</button>
<input type="range" id="scrub" min="0" max="1000" value="0" aria-label="Timeline">
<span class="time" id="time">0.0 / 0.0 s</span></div>
<div class="bar tools">
<button class="sm" id="reset">⏮ Reset</button><button class="sm" id="draw">✎ Draw path</button><button class="sm" id="erase">⌫ Eraser</button><button class="sm" id="pundo" hidden>Undo</button>
<label>Power <input type="number" id="pp" step=".1" min=".05" max="1" value=".6"></label><label>Smoothing″ <input type="number" id="ptol" step=".5" min=".5" value="2"></label>
<label class="chk" id="pkeepw" hidden><input type="checkbox" id="pkeep" checked> Keep heading</label>
<label>Speed <select id="rate"><option>0.5</option><option selected>1</option><option>2</option><option>4</option></select>×</label>
<label><input type="checkbox" id="trail" checked> Trail</label><span id="pose" class="hint" style="margin:0 0 0 4px"></span>
<button class="sm" id="theme" aria-label="Switch theme" title="Switch theme" style="margin-left:auto;background:#d97757;border-color:#d97757;padding:4px 7px;line-height:0"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><line x1="12" y1="12" x2="21.90" y2="13.39"/><line x1="12" y1="12" x2="17.20" y2="16.06"/><line x1="12" y1="12" x2="15.37" y2="20.34"/><line x1="12" y1="12" x2="10.97" y2="19.33"/><line x1="12" y1="12" x2="5.60" y2="20.20"/><line x1="12" y1="12" x2="6.25" y2="14.32"/><line x1="12" y1="12" x2="2.69" y2="10.69"/><line x1="12" y1="12" x2="6.48" y2="7.69"/><line x1="12" y1="12" x2="8.25" y2="2.73"/><line x1="12" y1="12" x2="12.95" y2="5.27"/><line x1="12" y1="12" x2="17.66" y2="4.75"/><line x1="12" y1="12" x2="19.05" y2="9.15"/></svg></button></div>
<div id="status"></div>
<p class="hint" id="pmsg"></p>
</section>
<div class="stack">
<section class="card"><h2>Generate with Claude</h2>
<textarea id="aiq" maxlength="2000" placeholder="Describe your auto, e.g. “Drive forward 3 feet, turn right, then drive to the center of the field.”"></textarea>
<div class="bar"><button class="p" id="aigo" disabled>Generate auto</button><button class="sm" id="aistop" hidden>Stop</button><button class="sm" id="aiundo" hidden>Undo</button><label class="chk"><input type="checkbox" id="aimod"> Modify current auto</label></div>
<div class="bar chips"><button data-ex="Drive forward 36 inches, turn right 90 degrees, then drive forward 24 inches.">Forward, right, forward</button><button data-ex="Drive in a square, 30 inches per side, ending where it started.">Square lap</button><button data-ex="Drive to the center of the field and stop facing right.">Go to center</button></div>
<p class="hint" id="aimsg">Connecting…</p></section>
<section class="card"><details id="stepsbox"><summary><h2 style="display:inline;margin:0">Autonomous steps</h2> <span id="scount" class="hint" style="margin:0 0 0 8px"></span></summary><div id="list" style="margin-top:8px"></div>
<div class="bar" style="margin-top:0">
<button class="sm" data-add="drive">+ Drive</button><button class="sm" data-add="turn">+ Turn</button><button class="sm" data-add="timed">+ Timed power</button><button class="sm" data-add="strafe" hidden>+ Strafe</button><button class="sm" data-add="move" hidden>+ Move</button><button class="sm" data-add="wait">+ Wait</button></div>
</details></section>
<section class="card"><h2>Drawn paths</h2><div id="plist"></div>
<div class="bar" style="margin-top:0"><button class="sm" id="pclear">Delete all drawings</button></div>
</section>
<section class="card"><h2>Robot &amp; start</h2><div class="set">
<label>Start X″ <input type="number" id="sx"></label><label>Start Y″ <input type="number" id="sy"></label>
<label>Start heading° <input type="number" id="sh"></label><label>Robot size″ <input type="number" id="size"></label>
<label>Speed at power 1 (in/s) <input type="number" id="vmax"></label><label>Wheel track″ <input type="number" id="track"></label>
<label>Left motor strength % <input type="number" id="drift"></label><label>Strafe speed % (strafer) <input type="number" id="seff"></label></div>
<div class="bar"><button class="sm" id="red">Red start (bottom)</button><button class="sm" id="blue">Blue start (top)</button><button class="sm" id="demo">Load demo</button><button class="sm" id="clear">Clear</button></div></section>
<section class="card"><h2>Motors (for the Java export)</h2><div id="mlist"></div><p class="hint" id="mwarn" style="margin-top:0"></p>
</section>
<section class="card"><h2>Field</h2>
<label class="chk"><input type="checkbox" id="fon" checked> Show the BIOBUZZ field image (hive and flowers block the robot)</label>
</section>
<section class="card"><h2>Save / share / code</h2>
<div class="bar" style="margin-top:0"><button class="sm" id="exp">Export JSON</button><button class="sm" id="imp">Import JSON</button><button class="sm" id="java">Make Java</button></div>
<textarea id="out" spellcheck="false" placeholder="Export JSON, paste JSON here and press Import, or make a time-based LinearOpMode."></textarea>
</section>
</div>
</main>
<script>
const $=id=>document.getElementById(id),cv=$('cv'),ctx=cv.getContext('2d'),S=cv.width/144,DT=0.01,D=Math.PI/180;
const norm=a=>((a+180)%360+360)%360-180,clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
const cfg={sx:0,sy:-55,sh:90,size:18,vmax:40,track:14,drift:0,seff:80},dm={m:'tank'};
const DEF={drive:{d:24,p:.6},turn:{a:90,p:.4},strafe:{d:12,p:.6},move:{f:12,r:12,p:.6},timed:{l:.5,r:.5,s:1},wait:{s:1}};
const LAB={drive:'Drive',turn:'Turn',strafe:'Strafe',move:'Move',timed:'Timed power',wait:'Wait'};
const FLD={drive:[['d','Dist″ (−=back)'],['p','Power']],turn:[['a','Deg° (+=left)'],['p','Power']],strafe:[['d','Right″ (−=left)'],['p','Power']],move:[['f','Fwd″'],['r','Right″'],['p','Power']],timed:[['l','Left'],['r','Right'],['s','Sec']],wait:[['s','Sec']]};
let steps=[],samples=[],stepT=[],hit=null,capped=false,t=0,total=0,playing=false,last=0,active=-2;
const field={on:true},IMG=new Image();let imgOk=false;IMG.onload=()=>{imgOk=true;draw()};IMG.src='data:image/png;base64,';
const OBS=[{n:'hive',x0:-25.3,x1:25.3,y0:-25.3,y1:25.3},{n:'flower',x0:-27,x1:-20.9,y0:66.9,y1:72},{n:'flower',x0:66.9,x1:72,y0:20.9,y1:27},{n:'flower',x0:-72,x1:-66.9,y0:-27,y1:-20.9},{n:'flower',x0:20.9,x1:27,y0:-72,y1:-66.9}];
const LZ={red:{x0:-47.5,x1:-24.5,y0:-72,y1:-61},blue:{x0:24.5,x1:47.5,y0:61,y1:72}};
function hits(P,h,o){const R=[[o.x0,o.y0],[o.x1,o.y0],[o.x1,o.y1],[o.x0,o.y1]],c=Math.cos(h),s=Math.sin(h);
 for(const[ux,uy]of[[1,0],[0,1],[c,s],[-s,c]]){const a=P.map(p=>p[0]*ux+p[1]*uy),b=R.map(p=>p[0]*ux+p[1]*uy);
  if(Math.max(...a)<=Math.min(...b)||Math.max(...b)<=Math.min(...a))return false}return true}
function blocked(x,y,h){const k=cfg.size/2,c=Math.cos(h),s=Math.sin(h),P=[[k,k],[k,-k],[-k,k],[-k,-k]].map(([a,b])=>[x+a*c-b*s,y+a*s+b*c]);
 if(P.some(q=>Math.abs(q[0])>72.001||Math.abs(q[1])>72.001))return'wall';
 if(field.on)for(const o of OBS)if(hits(P,h,o))return o.n;return''}
const MOT0=()=>({tank:{L:{n:'leftDrive',r:false,p:''},R:{n:'rightDrive',r:true,p:''}},strafe:{FL:{n:'frontLeft',r:false,p:''},FR:{n:'frontRight',r:true,p:''},BL:{n:'backLeft',r:false,p:''},BR:{n:'backRight',r:true,p:''}}});
const mot=MOT0(),MROLE={L:'Left motor',R:'Right motor',FL:'Front left',FR:'Front right',BL:'Back left',BR:'Back right'},MVAR={L:'leftDrive',R:'rightDrive',FL:'frontLeft',FR:'frontRight',BL:'backLeft',BR:'backRight'};
function setMotors(o){const d=MOT0();for(const m of['tank','strafe'])for(const k of Object.keys(d[m])){const v=o&&o[m]&&o[m][k];
  if(v&&typeof v==='object'){if(typeof v.n==='string'&&v.n.trim())d[m][k].n=v.n.trim().slice(0,40);d[m][k].r=v.r===true;const pt=String(v.p==null?'':v.p).replace(/\D/g,'').slice(0,2);d[m][k].p=pt}}
 for(const m of['tank','strafe'])Object.assign(mot[m],d[m])}
function renderMotors(){const L=$('mlist');if(!L)return;L.innerHTML='';
 for(const k of Object.keys(mot[dm.m])){const v=mot[dm.m][k],d=document.createElement('div');d.className='row mrow';
  d.innerHTML='<b>'+MROLE[k]+'</b><label>Name <input type="text" maxlength="40" data-k="'+k+'" data-f="n"></label><label>Port <input type="number" min="0" max="9" step="1" data-k="'+k+'" data-f="p"></label><label class="chk"><input type="checkbox" data-k="'+k+'" data-f="r"> Reversed</label>';
  d.querySelector('[data-f=n]').value=v.n;d.querySelector('[data-f=p]').value=v.p;d.querySelector('[data-f=r]').checked=v.r;L.appendChild(d)}
 motWarn()}
function motWarn(){const M=mot[dm.m],names=Object.values(M).map(v=>v.n.trim()||'?'),ports=Object.values(M).map(v=>v.p).filter(x=>x!==''),m=[];
 if(new Set(names).size<names.length)m.push('Two motors share the same name.');if(new Set(ports).size<ports.length)m.push('Two motors share the same port.');
 $('mwarn').textContent=m.join(' ')}
$('mlist').addEventListener('input',e=>{const k=e.target.dataset.k,f=e.target.dataset.f;if(!k)return;const v=mot[dm.m][k];
 if(f==='n')v.n=e.target.value.trim().slice(0,40)||MOT0()[dm.m][k].n;else if(f==='p')v.p=e.target.value.replace(/\D/g,'').slice(0,2);else v.r=e.target.checked;motWarn();save()});
function motorInit(){const M=mot[dm.m],q=n=>JSON.stringify(n);let c='';
 for(const k of Object.keys(M)){const v=M[k];c+='    '+MVAR[k]+' = hardwareMap.get(DcMotor.class, '+q(v.n)+');'+(v.p!==''?' // port '+v.p:'')+'\n'}
 for(const k of Object.keys(M))if(M[k].r)c+='    '+MVAR[k]+'.setDirection(DcMotor.Direction.REVERSE);\n';return c}
function applyMode(m){dm.m=m==='strafe'?'strafe':'tank';$('dm-tank').classList.toggle('p',dm.m==='tank');$('dm-strafe').classList.toggle('p',dm.m==='strafe');
 document.querySelectorAll('[data-add=strafe],[data-add=move]').forEach(b=>b.hidden=dm.m!=='strafe');$('pkeepw').hidden=dm.m!=='strafe';renderMotors()}
function setField(f){field.on=f.on!==false;$('fon').checked=field.on}
let skipped=[],drawMode=false,drawing=false,pts=[],pathSnap=null;
function wheelsOf(s,cfg){const P=v=>clamp(Math.abs(v),.05,1);
 if(s.t==='drive'){const g=P(s.p)*(s.d>=0?1:-1);return[g,g,g,g]}
 if(s.t==='turn'){const g=P(s.p)*(s.a>=0?1:-1);return[-g,g,-g,g]}
 if(s.t==='strafe'){const g=P(s.p)*(s.d>=0?1:-1);return[g,-g,-g,g]}
 if(s.t==='move'){const se=clamp(cfg.seff,10,150)/100,ff=s.f,rr=s.r/se,n=Math.max(Math.abs(ff+rr),Math.abs(ff-rr))||1,a=(ff+rr)/n*P(s.p),b=(ff-rr)/n*P(s.p);return[a,b,b,a]}
 if(s.t==='timed'){const l=clamp(s.l,-1,1),r=clamp(s.r,-1,1);return[l,r,l,r]}
 return[0,0,0,0]}
function sim(steps,cfg,mode){mode=mode||dm.m;
 let x=cfg.sx,y=cfg.sy,h=cfg.sh*D,time=0,hit=null,capped=false;const samples=[[x,y,h,-1]],stepT=[],skipped=[],se=clamp(cfg.seff,10,150)/100;
 {const b0=blocked(x,y,h);if(b0)hit={t:0,si:-1,what:b0}}
 const run=(si,W,until,maxT)=>{
  const k=1+cfg.drift/100,fl=W[0]*k,fr=W[1],bl=W[2]*k,br=W[3],st={dist:0,sd:0,ang:0,el:0};let vf,vs,w;
  if(mode==='strafe'){vf=(fl+fr+bl+br)/4;vs=se*(fl-fr-bl+br)/4;w=(-fl+fr-bl+br)/(4*cfg.track)}
  else{const L=(fl+bl)/2,R=(fr+br)/2;vf=(L+R)/2;vs=0;w=(R-L)/cfg.track}
  while(!until(st)&&st.el<maxT){
   if(time>300){capped=true;return}
   const c=Math.cos(h),sn=Math.sin(h),nh=h+w*DT,nx=x+(vf*c+vs*sn)*DT,ny=y+(vf*sn-vs*c)*DT;
   const bk=blocked(nx,ny,nh);if(!bk){x=nx;y=ny;h=nh}else{if(!hit)hit={t:time,si,what:bk};if(!blocked(x,y,nh))h=nh}
   st.dist+=vf*DT;st.sd+=vs*DT;st.ang+=w*DT;st.el+=DT;time+=DT;samples.push([x,y,h,si])}};
 steps.forEach((s,i)=>{const t0=time,W=wheelsOf(s,cfg).map(v=>v*cfg.vmax),sec=Math.max(0,s.s||0);
  if((s.t==='strafe'||s.t==='move')&&mode!=='strafe')skipped.push(i);
  else if(s.t==='drive')run(i,W,q=>Math.abs(q.dist)>=Math.abs(s.d),600);
  else if(s.t==='strafe')run(i,W,q=>Math.abs(q.sd)>=Math.abs(s.d),600);
  else if(s.t==='move')run(i,W,q=>Math.hypot(q.dist,q.sd)>=Math.hypot(s.f,s.r),600);
  else if(s.t==='turn')run(i,W,q=>Math.abs(q.ang)>=Math.abs(s.a)*D,600);
  else if(s.t==='timed')run(i,W,q=>q.el>=sec-1e-9,sec+1);
  else run(i,W,q=>q.el>=sec-1e-9,sec+1);
  stepT.push([t0,time])});
 return{samples,stepT,hit,capped,skipped,total:(samples.length-1)*DT};
}
function simulate(){const r=sim(steps,cfg);({samples,stepT,hit,capped,total,skipped}=r);t=Math.min(t,total)}
const at=tt=>samples[clamp(Math.round(tt/DT),0,samples.length-1)];
const X=x=>(x+72)*S,Y=y=>(72-y)*S,css=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim()||'#888';
function drawEls(){}
function draw(){
 ctx.fillStyle=css('--field');ctx.fillRect(0,0,720,720);
 ctx.strokeStyle=css('--grid');ctx.lineWidth=1;
 const useImg=field.on&&imgOk,ink=useImg?'#fff':css('--text');
 if(useImg)ctx.drawImage(IMG,0,0,720,720);else for(let i=0;i<=6;i++){const v=i*24*S;ctx.beginPath();ctx.moveTo(v,0);ctx.lineTo(v,720);ctx.moveTo(0,v);ctx.lineTo(720,v);ctx.stroke()}
 if(!useImg){ctx.fillStyle=css('--mute');ctx.font='11px system-ui';ctx.fillText('(0,0)',X(0)+4,Y(0)-4)}drawEls();
 const cur=at(t),idx=clamp(Math.round(t/DT),0,samples.length-1);
 ctx.lineWidth=2;ctx.strokeStyle=useImg?'rgba(255,255,255,.4)':css('--grid');ctx.beginPath();
 samples.forEach((s,i)=>{if(i%4&&i!==samples.length-1)return;i?ctx.lineTo(X(s[0]),Y(s[1])):ctx.moveTo(X(s[0]),Y(s[1]))});ctx.stroke();
 if($('trail').checked){ctx.lineWidth=3;ctx.strokeStyle=css('--acc');ctx.beginPath();
  for(let i=0;i<=idx;i+=4){const s=samples[i];i?ctx.lineTo(X(s[0]),Y(s[1])):ctx.moveTo(X(s[0]),Y(s[1]))}
  ctx.lineTo(X(cur[0]),Y(cur[1]));ctx.stroke()}
 {const mk=new Map();stepT.forEach((r,i)=>{const sm=samples[clamp(Math.round(r[1]/DT),0,samples.length-1)],key=Math.round(sm[0])+','+Math.round(sm[1]);
  let m=mk.get(key);if(!m){m={x:sm[0],y:sm[1],nums:[],act:false,drawn:true};mk.set(key,m)}
