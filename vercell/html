  if(st&&isFinite(num(st.x))&&isFinite(num(st.y))&&isFinite(num(st.h))){cfg.sx=num(st.x);cfg.sy=num(st.y);cfg.sh=num(st.h);for(const k of['sx','sy','sh'])$(k).value=cfg[k]}
  t=0;refresh();playing=true;last=performance.now();draw();ai.undo.hidden=false;
  ai.msg.textContent=(res&&typeof res.notes==='string'&&res.notes?res.notes:'Done.')+(bad?' ('+bad+' invalid step'+(bad>1?'s were':' was')+' skipped.)':'');
 }catch(e){const c=e&&e.code;
  ai.msg.textContent=c==='cancelled'?'Stopped.':c==='not_granted'?'Allow Claude access when asked to generate autos.':c==='rate_limited'?'Too many requests. Wait a moment and try again.':'Couldn’t generate an auto: '+((e&&e.message)||'unknown error')}
 finally{ai.go.disabled=false;ai.stop.hidden=true;ctl=null}};
renderMotors();refresh();requestAnimationFrame(tick);
